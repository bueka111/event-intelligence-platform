# Supabase (Projekt-Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modell fuer Lead-Anreicherung/Scoring. claude-opus-5 = beste Qualitaet.
# Fuer hohes Lead-Volumen guenstiger: claude-sonnet-5 oder claude-haiku-4-5.
ANTHROPIC_LEAD_MODEL=claude-opus-5

# Kostenloser Mock-Modus zum Testen des UI-Flows ohne Anthropic-Guthaben.
# true = kein API-Call, nur Heuristik-Fake-Score. Fuer echtes Scoring: false.
ANTHROPIC_MOCK=false
